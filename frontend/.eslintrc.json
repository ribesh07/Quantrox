{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    // Disable type checking for any type
    "@typescript-eslint/no-explicit-any": "off",
    // Disable unused variables check
    "@typescript-eslint/no-unused-vars": "off",
    // Disable react hooks exhaustive deps
    "react-hooks/exhaustive-deps": "off",
    // Disable no console
    "no-console": "off",
    // Disable no empty interface
    "@typescript-eslint/no-empty-interface": "off",
    // Disable require await
    "@typescript-eslint/require-await": "off",
    // Disable no unsafe assignment
    "@typescript-eslint/no-unsafe-assignment": "off",
    // Disable no unsafe member access
    "@typescript-eslint/no-unsafe-member-access": "off",
    // Disable no unsafe call
    "@typescript-eslint/no-unsafe-call": "off"
  }
}
