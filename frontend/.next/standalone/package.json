{
  "name": "quantrox-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=@quantrox/frontend",
    "dev:backend": "npm run dev --workspace=@quantrox/backend",
    "build:shared": "npm run build --workspace=@quantrox/shared",
    "build:frontend": "npm run build --workspace=@quantrox/frontend",
    "build:backend": "npm run build --workspace=@quantrox/backend",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "install:all": "npm install"
  }
}
