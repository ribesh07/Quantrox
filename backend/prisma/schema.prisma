generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  username              String                 @unique
  email                 String                 @unique
  password              String
  role                  Role                   @default(USER)
  status                UserStatus             @default(VERIFICATION_PENDING)
  twoFactorEnabled      Boolean                @default(false)
  twoFactorSecret       String?
  twoFactorBackupCodes  String?                // JSON stringified array
  lastLoginAt           DateTime?
  lastLoginIp           String?
  lastLoginDeviceInfo   String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  adminLogs             AdminLog[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference?
  orders                Order[]
  transactions          Transaction[]
  wallets               Wallet[]
  devices               Device[]
  proofUploads          ProofUpload[]
  exchangeRequests      ExchangeRequest[]
  gamePointOrders       GamePointOrder[]
  refreshTokens         RefreshToken[]
  verificationTokens    VerificationToken[]
  
  // Merchant specific fields
  merchantInfo          MerchantInfo?
  transactionReports    TransactionReport[]
  merchantQRCodes       MerchantQRCode[]
  deposits              Deposit[]
  payoutRequests        PayoutRequest[]
  gameIdRequests        GameIdRequest[]
}

model MerchantInfo {
  id                      String          @id @default(cuid())
  userId                  String          @unique
  businessName            String
  businessDescription     String?
  preferredWalletId       String
  expectedDailyVolume     Float
  approvedAt              DateTime?
  approvedBy              String?
  adminNote               String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  user                    User            @relation(fields: [userId], references: [id])
  preferredWallet         Wallet          @relation(fields: [preferredWalletId], references: [id])
  merchantWallets         MerchantWallet[]
}

model MerchantWallet {
  id              String        @id @default(cuid())
  merchantInfoId  String
  paymentMethodId String
  dailyLimit      Float         @default(0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  merchantInfo    MerchantInfo  @relation(fields: [merchantInfoId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@unique([merchantInfoId, paymentMethodId])
}

model TransactionReport {
  id                      String                  @id @default(cuid())
  userId                  String
  transactionDate         DateTime
  totalTransactions       Int
  totalAmount             Float
  proofImage              String?
  notes                   String?
  status                  ReportStatus            @default(PENDING_REVIEW)
  reviewedAt              DateTime?
  reviewedBy              String?
  rejectionReason         String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  user                    User                    @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model MerchantQRCode {
  id                      String          @id @default(cuid())
  userId                  String
  label                   String?
  imageUrl                String
  assignedBy              String
  assignedAt              DateTime        @default(now())
  active                  Boolean         @default(true)
  disabledAt              DateTime?
  history                 String?         // JSON array of QR code changes
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  user                    User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Deposit {
  id                      String              @id @default(cuid())
  userId                  String
  amount                  Float
  type                    DepositType
  status                  DepositStatus       @default(PENDING)
  requiredDeposit         Float               @default(0)
  notes                   String?
  adjustedBy              String?
  adjustedAt              DateTime?
  frozenAt                DateTime?
  frozenBy                String?
  releasedAt              DateTime?
  releasedBy              String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  user                    User                @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PayoutRequest {
  id                String         @id @default(cuid())
  userId            String
  paymentMethodId   String?
  amount            Float
  uid               String?
  walletAddress     String?
  walletNetwork     String?
  qrCodeImage       String?
  remarks           String?
  status            PayoutStatus   @default(PENDING)
  approvedAt        DateTime?
  approvedBy        String?
  rejectedAt        DateTime?
  rejectedBy        String?
  rejectionReason   String?
  paidAt            DateTime?
  transactionHash   String?
  paymentProofImage String?
  paidBy            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id])
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethodId])
}

model Wallet {
  id              String        @id @default(cuid())
  userId          String
  paymentMethodId String
  balance         Float         @default(0)
  pendingBalance  Float         @default(0)
  frozenBalance   Float         @default(0)
  status          WalletStatus  @default(ACTIVE)
  lastActivityAt  DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  transactions    WalletTransaction[]
    merchantInfos MerchantInfo[]

  @@unique([userId, paymentMethodId])
}

model Game {
  id        String          @id @default(cuid())
  name      String
  logo      String?
  buyRate   Float           @default(0)
  sellRate  Float           @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  orders    Order[]
  gameIdRequests GameIdRequest[]
}

model PaymentMethod {
  id            String                @id @default(cuid())
  name          String                @unique
  category      PaymentMethodCategory @default(BOTH)
  qrCode        String?
  details       String?
  feePercentage Float                 @default(0)
  rate          Float                 @default(1)
  active        Boolean               @default(true)
  minAmount     Float                 @default(0)
  maxAmount     Float                 @default(1000000)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now())
  orders          Order[]
  wallets         Wallet[]
  payoutRequests  PayoutRequest[]
  merchantWallets MerchantWallet[]
}

model QRCode {
  id        String   @id @default(cuid())
  image     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  type            OrderType
  paymentMethodId String
  amount          Float
  fee             Float         @default(0)
  total           Float
  rate            Float         @default(1)
  receivedAmount  Float         @default(0)
  status          OrderStatus   @default(PENDING_PAYMENT)
  screenshot      String?
  adminNote       String?
  walletAddress   String?
  gameId          String?
  gameUsername    String?
  statusHistory   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  game            Game?         @relation(fields: [gameId], references: [id])
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  transaction     Transaction?
  proofUploads    ProofUpload[]

  fromWalletId String?
  toWalletId String?

  transactionReference String?

  receiveUsername String?
  receiveWalletNumber String?
  receiveEmail String?
  receivePhone String?
  receiveQrCode String?



 
}

model Transaction {
  id               String   @id @default(cuid())
  orderId          String   @unique
  userId           String
  amount           Float
  type             String
  status           String
  internalNotes    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order    @relation(fields: [orderId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  details   String?
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id])
}

// New models for complete platform

model Device {
  id           String   @id @default(cuid())
  userId       String
  deviceInfo   String   // JSON: { name, browser, os, ip }
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model ExchangeRate {
  id              String   @id @default(cuid())
  paymentMethodId String
  baseCurrency    String   @default("USD")
  targetCurrency  String   @default("USDT")
  rate            Float
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FeeSetting {
  id                 String   @id @default(cuid())
  feeType            FeeType
  paymentMethodId    String?  // null means global default
  percentage         Float    @default(0)
  fixedAmount        Float    @default(0)
  minAmount          Float    @default(0)
  maxAmount          Float    @default(999999)
  description        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SystemSettings {
  id                     String  @id @default(cuid())
  minExchangeAmount      Float   @default(10)
  maxExchangeAmount      Float   @default(50000)
  minGamePurchaseAmount  Float   @default(5)
  maxGamePurchaseAmount  Float   @default(10000)
  exchangeProcessTime    Int     @default(300) // in seconds (5-30 minutes)
  requiresApprovalAmount Float   @default(5000)
  twoFactorRequired      Boolean @default(false)
  maintenanceMode        Boolean @default(false)
  maintenanceMessage     String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PaymentAccount {
  id              String   @id @default(cuid())
  paymentMethodId String   @unique
  accountName     String?
  accountNumber   String?
  walletAddress   String?
  email           String?
  instructions    String?
  qrCodeUrl       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProofUpload {
  id             String   @id @default(cuid())
  userId         String
  orderId        String
  fileUrl        String
  fileType       String   // png, jpg, jpeg, pdf
  referenceNo    String?
  notes          String?
  uploadedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([userId])
}

model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  orderId       String?
  type          TransactionType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  notes         String?
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([createdAt])
}

model NotificationTemplate {
  id       String @id @default(cuid())
  code     String @unique
  title    String
  subject  String
  body     String // Template with {{variables}}
  type     String // EMAIL, IN_APP, SMS
  isActive Boolean @default(true)
}

model NotificationPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique
  emailOnTransaction  Boolean @default(true)
  emailOnApproval     Boolean @default(true)
  emailOnRejection    Boolean @default(true)
  emailOnPayment      Boolean @default(true)
  inAppNotifications  Boolean @default(true)
  pushNotifications   Boolean @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  title          String
  message        String
  type           NotificationType @default(INFO)
  referenceType  String?  // ORDER, TRANSACTION, etc
  referenceId    String?
  read           Boolean  @default(false)
  readAt         DateTime?
  sentViaEmail   Boolean  @default(false)
  sentViaInApp   Boolean  @default(true)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String
  userEmail      String
  action         String
  resource       String   // USER, ORDER, WALLET, etc
  resourceId     String?
  changes        String?  // JSON: { before, after }
  ipAddress      String?
  userAgent      String?
  result         String   // SUCCESS, FAILED
  failureReason  String?
  createdAt      DateTime @default(now())
  
  @@index([userId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  type       String   // EMAIL_VERIFICATION | PASSWORD_RESET
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}


model ExchangeRequest {
  id              String   @id @default(cuid())
  userId          String
  amount          Float
  fee             Float
  total           Float
  rate            Float
  usdtReceived    Float
  walletAddress   String
  paymentMethodId String
  status          ExchangeStatus @default(PENDING_PAYMENT)
  proofUploadedAt DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  internalNotes   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model GamePointOrder {
  id              String   @id @default(cuid())
  userId          String
  gameId          String
  points          Int
  pricePerPoint   Float
  totalPrice      Float
  fee             Float
  finalPrice      Float
  paymentMethodId String
  gameUsername    String
  status          GamePointOrderStatus @default(PENDING)
  proofUploadedAt DateTime?
  fulfilledAt     DateTime?
  internalNotes   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum Role {
  USER
  STAFF_ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum OrderType {
  DEPOSIT
  EXCHANGE
  GAME_TOPUP
}

enum PaymentMethodCategory {
  DEPOSIT
  EXCHANGE
  BOTH
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  VERIFICATION_PENDING
}

enum WalletStatus {
  ACTIVE
  FROZEN
  BLOCKED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  FEE
  REFUND
  GAME_PURCHASE
  EXCHANGE_RECEIVED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  TRANSACTION
  ORDER_UPDATE
}

enum ExchangeStatus {
  PENDING_PAYMENT
  PAYMENT_RECEIVED
  PENDING_VERIFICATION
  VERIFIED
  PENDING_TRANSFER
  TRANSFERRED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum GamePointOrderStatus {
  PENDING
  PAYMENT_RECEIVED
  PENDING_FULFILLMENT
  FULFILLED
  FAILED
  CANCELLED
}

model GameIdRequest {
  id              String              @id @default(cuid())
  userId          String
  gameId          String
  requestType     GameIdRequestType   @default(EMAIL_PASSWORD)
  gameUsername    String?
  email           String?
  password        String?
  status          GameIdRequestStatus @default(PENDING)
  response        String?
  respondedAt     DateTime?
  respondedBy     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id])
  game            Game                @relation(fields: [gameId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum GameIdRequestType {
  GAME_ID
  EMAIL_PASSWORD
}

enum GameIdRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeeType {
  EXCHANGE_FEE
  DEPOSIT_FEE
  WITHDRAWAL_FEE
  TRANSFER_FEE
}

enum ReportStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DepositType {
  INITIAL
  ADDITIONAL
  ADJUSTMENT
  WITHDRAWAL
}

enum DepositStatus {
  PENDING
  APPROVED
  FROZEN
  RELEASED
  REJECTED
}

enum PayoutStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PAID
  REJECTED
}
