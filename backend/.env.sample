# Copy to .env and fill values
JWT_SECRET=replace_with_a_secure_random_value
ENCRYPTION_KEY=replace_with_32_byte_hex_key
DATABASE_URL=postgresql://user:password@localhost:5432/quantrox?schema=public
FRONTEND_URL=http://localhost:3000
PORT=3001
UPLOAD_DIR=./uploads

# SMTP (optional) - leave blank to use console fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# CORS origins (comma separated)
CORS_ORIGIN=*
